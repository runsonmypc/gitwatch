#!/bin/bash
# `watch` runs its command via `sh -c`, which on many Linux distros (Pop!_OS,
# Debian, Ubuntu) is dash — and dash chokes on the bashisms below (here-strings,
# substring expansion). Re-exec ourselves under bash via watch to guarantee the
# render body actually runs in bash.
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [ "$1" != "--render" ]; then
  # Optional procps-ng flags, feature-detected so older watch builds still run:
  #   -w  truncate long lines instead of wrapping them
  #   -s  write stray screenshots (the "s" key) to a temp dir, not the repo
  WHELP=$(watch --help 2>&1)
  WOPTS=()
  case "$WHELP" in *--no-wrap*) WOPTS+=(-w) ;; esac
  case "$WHELP" in *--shotsdir*) WOPTS+=(-s "${TMPDIR:-/tmp}") ;; esac
  exec watch -t -n 1 -c "${WOPTS[@]}" "bash '$SCRIPT_PATH' --render"
fi

# Icon setup (auto-detect Nerd Fonts)
if [ -n "$GW_ICONS" ] || ls ~/Library/Fonts/*[Nn]erd* /Library/Fonts/*[Nn]erd* 2>/dev/null | grep -q . || (command -v fc-list >/dev/null 2>&1 && fc-list 2>/dev/null | grep -qi "nerd font"); then
  ICON_BRANCH=$(printf "\xee\x82\xa0")
  ICON_FILE=$(printf "\xef\x85\x9b")
else
  ICON_BRANCH=""
  ICON_FILE="Δ"
fi

# Terminal geometry. watch exports COLUMNS/LINES; under $(...) the TIOCGWINSZ
# ioctl fails, so the env var is the only reliable signal.
cols=${COLUMNS:-$(tput cols 2>/dev/null)}
case "$cols" in *[!0-9]*|"") cols=80 ;; esac
[ "$cols" -lt 20 ] && cols=80
rows=${LINES:-$(tput lines 2>/dev/null)}
case "$rows" in *[!0-9]*|"") rows=24 ;; esac

# Track lines used for dynamic commit count
lines_used=0

TAB=$(printf "\t")
ESC=$(printf "\033")
NL="
"
GRN="${ESC}[32m"
RED="${ESC}[31m"
YEL="${ESC}[33m"
DIM="${ESC}[2m"
RST="${ESC}[0m"

# Signed human-readable byte count: 25074 -> +24K
hsize() {
  n=$1
  [ "$n" -eq 0 ] && echo "0B" && return
  sgn=+
  if [ "$n" -lt 0 ]; then sgn=-; n=$((0 - n)); fi
  if [ "$n" -lt 1024 ]; then echo "${sgn}${n}B"
  elif [ "$n" -lt 1048576 ]; then echo "${sgn}$((n / 1024))K"
  else echo "${sgn}$((n / 1048576))M"; fi
}

# Render "path<TAB>plain<TAB>colored" rows as an aligned table that fits in $cols.
# Width math only ever touches the plain field, never the colored one, so ANSI
# escapes cannot corrupt the alignment.
render_table() {
  rt_rows=$1
  rt_maxstat=0
  rt_maxname=0
  while IFS="$TAB" read -r p s c; do
    [ -z "$p" ] && continue
    [ ${#s} -gt $rt_maxstat ] && rt_maxstat=${#s}
  done <<< "$rt_rows"
  # overhead: leading space (1) + " | " (3)
  rt_avail=$((cols - 4 - rt_maxstat))
  [ $rt_avail -lt 8 ] && rt_avail=8
  rt_out=""
  while IFS="$TAB" read -r p s c; do
    [ -z "$p" ] && continue
    if [ ${#p} -gt $rt_avail ]; then
      t=${p: -$((rt_avail - 4))}
      t=${t#*/}
      p=".../$t"
    fi
    [ ${#p} -gt $rt_maxname ] && rt_maxname=${#p}
    rt_out="${rt_out}${p}${TAB}${s}${TAB}${c}${NL}"
  done <<< "$rt_rows"
  while IFS="$TAB" read -r p s c; do
    [ -z "$p" ] && continue
    printf " %-${rt_maxname}s | %*s%s\n" "$p" $((rt_maxstat - ${#s})) "" "$c"
  done <<< "$rt_out"
}

# Emit "path<TAB>plain<TAB>colored" rows for a diff. $1 is --cached or empty.
# numstat gives the counts and an untruncated path; --stat is consulted only for
# binary rows, to scrape the "Bin <old> -> <new> bytes" sizes. Both emit rows in
# the same order, so they are joined by line index rather than by path.
diff_rows() {
  dr_ns=$(git diff $1 --numstat 2>/dev/null)
  [ -z "$dr_ns" ] && return
  # An unmerged path appears more than once in --numstat: a 0/0 placeholder plus
  # a row with the real counts. Keep one row per path, the one with most churn.
  dr_ns=$(printf "%s\n" "$dr_ns" | awk -F"$TAB" "{
    k = \$3
    s = (\$1 == \"-\") ? 2147483647 : \$1 + \$2
    if (!(k in seen)) { seen[k] = ++n; ord[n] = k; best[k] = \$0; sc[k] = s }
    else if (s > sc[k]) { best[k] = \$0; sc[k] = s }
  } END { for (i = 1; i <= n; i++) print best[ord[i]] }")
  dr_st=""
  case "$dr_ns" in
    *"-${TAB}-${TAB}"*)
      # anchor the summary-line match: an unmerged --stat entry can itself
      # contain the text "1 file changed" without being the summary
      dr_st=$(git diff $1 --stat=400 2>/dev/null | sed "/^ *[0-9][0-9]* files\{0,1\} changed/d")
      # the line-index join only holds when both sides have one row per file
      if [ "$(printf "%s\n" "$dr_ns" | wc -l)" != "$(printf "%s\n" "$dr_st" | wc -l)" ]; then
        dr_st=""
      fi
      ;;
  esac
  while IFS="$TAB" read -r add del path <&3; do
    [ -z "$path" ] && continue
    IFS= read -r sline <&4 || sline=""
    if [ "$add" = "-" ]; then
      rest=${sline#*Bin }
      old=${rest%% *}
      rest=${rest#*-> }
      new=${rest%% *}
      case "$old" in *[!0-9]*|"") old=0 ;; esac
      case "$new" in *[!0-9]*|"") new=0 ;; esac
      d=$((new - old))
      plain=$(hsize $d)
      if [ $d -lt 0 ]; then colored="${RED}${plain}${RST}"
      elif [ $d -gt 0 ]; then colored="${GRN}${plain}${RST}"
      else colored="${DIM}${plain}${RST}"; fi
    else
      case "$add" in *[!0-9]*|"") add=0 ;; esac
      case "$del" in *[!0-9]*|"") del=0 ;; esac
      plain=""
      colored=""
      if [ "$add" -gt 0 ]; then plain="+$add"; colored="${GRN}+${add}${RST}"; fi
      if [ "$del" -gt 0 ]; then
        if [ -n "$plain" ]; then plain="$plain "; colored="$colored "; fi
        plain="$plain-$del"
        colored="${colored}${RED}-${del}${RST}"
      fi
      if [ -z "$plain" ]; then plain="0"; colored="${DIM}0${RST}"; fi
    fi
    printf "%s${TAB}%s${TAB}%s\n" "$path" "$plain" "$colored"
  done 3<<< "$dr_ns" 4<<< "$dr_st"
}

# Branch + sync status
branch=$(git branch --show-current)
upstream=$(git rev-parse --abbrev-ref @{u} 2>/dev/null)
if [ -n "$upstream" ]; then
  counts=$(git rev-list --left-right --count $upstream...HEAD 2>/dev/null)
  behind=$(echo $counts | awk "{print \$1}")
  ahead=$(echo $counts | awk "{print \$2}")
  [ -z "$ahead" ] && ahead=0
  [ -z "$behind" ] && behind=0
  sync=""
  [ "$ahead" -gt 0 ] && sync="${sync} ↑${ahead}"
  [ "$behind" -gt 0 ] && sync="${sync} ↓${behind}"
  [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ] && sync=" ✓"
  printf "\033[35m${ICON_BRANCH}%s\033[0m%s\n" "$branch" "$sync"
else
  printf "\033[35m${ICON_BRANCH}%s\033[0m \033[2m(no remote)\033[0m\n" "$branch"
fi
lines_used=$((lines_used + 1))

echo ""
lines_used=$((lines_used + 1))

# Staged changes
staged_rows=$(diff_rows --cached)
if [ -n "$staged_rows" ]; then
  printf "\033[94m● staged\033[0m\n"
  render_table "$staged_rows"
  echo ""
  staged_lines=$(printf "%s\n" "$staged_rows" | wc -l | tr -d " ")
  lines_used=$((lines_used + 1 + staged_lines + 1))
fi

# Unstaged changes
unstaged_rows=$(diff_rows)
if [ -n "$unstaged_rows" ]; then
  printf "\033[36m○ unstaged\033[0m\n"
  render_table "$unstaged_rows"
  echo ""
  unstaged_lines=$(printf "%s\n" "$unstaged_rows" | wc -l | tr -d " ")
  lines_used=$((lines_used + 1 + unstaged_lines + 1))
fi

# Untracked files
untracked=$(git status --porcelain -uall | grep "^??" | cut -c4- | sed "s/^\"//;s/\"$//")
if [ -n "$untracked" ]; then
  printf "\033[33m◌ untracked\033[0m\n"
  urows=""
  untracked_count=0
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    # one git call yields both the binary flag and the line count.
    # -- keeps a leading-dash filename from being parsed as an option.
    info=$(git diff --no-index --numstat -- /dev/null "$file" 2>/dev/null | head -1)
    add=${info%%"$TAB"*}
    if [ "$add" = "-" ]; then
      sz=$(wc -c < "$file" 2>/dev/null | tr -d " ")
      case "$sz" in *[!0-9]*|"") sz=0 ;; esac
      plain=$(hsize $sz)
    else
      case "$add" in *[!0-9]*|"") add=0 ;; esac
      plain="+$add"
    fi
    urows="${urows}${file}${TAB}${plain}${TAB}${YEL}${plain}${RST}${NL}"
    untracked_count=$((untracked_count + 1))
  done <<< "$untracked"
  render_table "$urows"
  echo ""
  lines_used=$((lines_used + 1 + untracked_count + 1))
fi

# Summary at the bottom
tracked=$(git diff --shortstat 2>/dev/null | awk "{
  files=\$1
  ins=0; del=0
  for(i=1;i<=NF;i++) {
    if(\$i ~ /insertion/) ins=\$(i-1)
    if(\$i ~ /deletion/) del=\$(i-1)
  }
  if(files) printf \"\033[32m+%d\033[0m \033[31m-%d\033[0m \033[2m| %d${ICON_FILE}\033[0m\", ins, del, files
}")
newcount=$(git status --porcelain -uall 2>/dev/null | grep -c "^??")
if [ -n "$tracked" ] && [ "$newcount" -gt 0 ]; then
  printf " %s  \033[2m+%d new\033[0m\n" "$tracked" "$newcount"
  lines_used=$((lines_used + 1))
elif [ -n "$tracked" ]; then
  printf " %s\n" "$tracked"
  lines_used=$((lines_used + 1))
elif [ "$newcount" -gt 0 ]; then
  printf " \033[2m+%d new\033[0m\n" "$newcount"
  lines_used=$((lines_used + 1))
fi

echo ""
lines_used=$((lines_used + 1))

# Commits (fill remaining vertical space)
remote_hash=$(git rev-parse @{u} 2>/dev/null)
avail_rows=$((rows - lines_used))
[ $avail_rows -lt 1 ] && avail_rows=1
if [ -n "$remote_hash" ]; then
  ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
  min_count=$((ahead + 1))
  [ $min_count -lt 3 ] && min_count=3
  count=$avail_rows
  [ $count -lt $min_count ] && count=$min_count
else
  count=$avail_rows
  [ $count -lt 3 ] && count=3
fi
if [ -n "$GW_ICONS" ] || ls ~/Library/Fonts/*[Nn]erd* /Library/Fonts/*[Nn]erd* 2>/dev/null | grep -q . || (command -v fc-list >/dev/null 2>&1 && fc-list 2>/dev/null | grep -qi "nerd font"); then
  ICON_CLOUD=$(printf "\xef\x83\x82")
  ICON_HEAD=$(printf "\xef\x86\x92")      # fa-dot-circle-o (you are here)
  # Conventional commit type icons
  ICON_FEAT=$(printf "\xef\x84\xb5")      # fa-rocket
  ICON_FIX=$(printf "\xef\x82\xad")       # fa-wrench
  ICON_DOCS=$(printf "\xef\x80\xad")      # fa-book
  ICON_STYLE=$(printf "\xee\x88\xab")     # fae-palette_color
  ICON_REFACTOR=$(printf "\xef\x80\xa1")  # fa-refresh
  ICON_TEST=$(printf "\xef\x83\x83")      # fa-flask
  ICON_CHORE=$(printf "\xef\x80\x93")     # fa-cog
  ICON_PERF=$(printf "\xef\x83\xa7")      # fa-bolt
  ICON_CI=$(printf "\xef\x82\x85")        # fa-cogs
  ICON_BUILD=$(printf "\xef\x86\xb2")     # fa-cube
  ICON_REVERT=$(printf "\xef\x83\xa2")    # fa-undo
  ICON_SKILL=$(printf "\xef\x83\xaa")     # fa-clipboard
  ICON_CASE=$(printf "\xef\x82\xb1")      # fa-briefcase
  ICON_TOOL=$(printf "\xee\xb8\x9b")      # fa-toolbox
  ICON_SPEC=$(printf "\xee\xb5\xbb")      # fa-clipboard-list
  ICON_EXPERIMENT=$(printf "\xee\x88\xa2") # fae-microscope
  ICON_DELETE=$(printf "\xef\x87\xb8")    # fa-trash
  ICON_CALIBRATE=$(printf "\xf3\xb0\x8d\x98") # md-math_compass
  ICON_SETTINGS=$(printf "\xef\x87\x9e")     # fa-sliders
  ICON_MERGE=$(printf "\xee\x9c\xa7")        # dev-git_merge
else
  ICON_CLOUD="☁"
  ICON_HEAD="*"
fi
head_hash=$(git rev-parse HEAD 2>/dev/null)
git log -$count --format="%H|%s|%cr" | while IFS="|" read -r hash msg time; do
  # Transform conventional commits to icons (Nerd Fonts only)
  if [ -n "$ICON_FEAT" ]; then
    # Scoped: "type(scope): msg" → "icon scope: msg"
    msg=$(echo "$msg" | sed \
      -e "s/^feat(\([^)]*\)): /$ICON_FEAT \1: /" \
      -e "s/^fix(\([^)]*\)): /$ICON_FIX \1: /" \
      -e "s/^docs(\([^)]*\)): /$ICON_DOCS \1: /" \
      -e "s/^style(\([^)]*\)): /$ICON_STYLE \1: /" \
      -e "s/^refactor(\([^)]*\)): /$ICON_REFACTOR \1: /" \
      -e "s/^test(\([^)]*\)): /$ICON_TEST \1: /" \
      -e "s/^chore(\([^)]*\)): /$ICON_CHORE \1: /" \
      -e "s/^perf(\([^)]*\)): /$ICON_PERF \1: /" \
      -e "s/^ci(\([^)]*\)): /$ICON_CI \1: /" \
      -e "s/^build(\([^)]*\)): /$ICON_BUILD \1: /" \
      -e "s/^revert(\([^)]*\)): /$ICON_REVERT \1: /" \
      -e "s/^skill(\([^)]*\)): /$ICON_SKILL \1: /" \
      -e "s/^case(\([^)]*\)): /$ICON_CASE \1: /" \
      -e "s/^cases(\([^)]*\)): /$ICON_CASE \1: /" \
      -e "s/^tool(\([^)]*\)): /$ICON_TOOL \1: /" \
      -e "s/^tools(\([^)]*\)): /$ICON_TOOL \1: /" \
      -e "s/^spec(\([^)]*\)): /$ICON_SPEC \1: /" \
      -e "s/^specs(\([^)]*\)): /$ICON_SPEC \1: /" \
      -e "s/^openspec(\([^)]*\)): /$ICON_SPEC \1: /" \
      -e "s/^openspecs(\([^)]*\)): /$ICON_SPEC \1: /" \
      -e "s/^experiment(\([^)]*\)): /$ICON_EXPERIMENT \1: /" \
      -e "s/^experiments(\([^)]*\)): /$ICON_EXPERIMENT \1: /" \
      -e "s/^delete(\([^)]*\)): /$ICON_DELETE \1: /" \
      -e "s/^calibrate(\([^)]*\)): /$ICON_CALIBRATE \1: /" \
      -e "s/^calibration(\([^)]*\)): /$ICON_CALIBRATE \1: /" \
      -e "s/^settings(\([^)]*\)): /$ICON_SETTINGS \1: /" \
      -e "s/^config(\([^)]*\)): /$ICON_SETTINGS \1: /" \
      -e "s/^merge(\([^)]*\)): /$ICON_MERGE \1: /")
    # Scopeless: "type: msg" → "icon msg"
    msg=$(echo "$msg" | sed \
      -e "s/^feat: /$ICON_FEAT /" \
      -e "s/^fix: /$ICON_FIX /" \
      -e "s/^docs: /$ICON_DOCS /" \
      -e "s/^style: /$ICON_STYLE /" \
      -e "s/^refactor: /$ICON_REFACTOR /" \
      -e "s/^test: /$ICON_TEST /" \
      -e "s/^chore: /$ICON_CHORE /" \
      -e "s/^perf: /$ICON_PERF /" \
      -e "s/^ci: /$ICON_CI /" \
      -e "s/^build: /$ICON_BUILD /" \
      -e "s/^revert: /$ICON_REVERT /" \
      -e "s/^skill: /$ICON_SKILL /" \
      -e "s/^case: /$ICON_CASE /" \
      -e "s/^cases: /$ICON_CASE /" \
      -e "s/^tool: /$ICON_TOOL /" \
      -e "s/^tools: /$ICON_TOOL /" \
      -e "s/^spec: /$ICON_SPEC /" \
      -e "s/^specs: /$ICON_SPEC /" \
      -e "s/^openspec: /$ICON_SPEC /" \
      -e "s/^openspecs: /$ICON_SPEC /" \
      -e "s/^experiment: /$ICON_EXPERIMENT /" \
      -e "s/^experiments: /$ICON_EXPERIMENT /" \
      -e "s/^delete: /$ICON_DELETE /" \
      -e "s/^calibrate: /$ICON_CALIBRATE /" \
      -e "s/^calibration: /$ICON_CALIBRATE /" \
      -e "s/^settings: /$ICON_SETTINGS /" \
      -e "s/^config: /$ICON_SETTINGS /" \
      -e "s/^merge: /$ICON_MERGE /")
  fi
  # Compact time: "3 hours ago" -> "3h"
  time=$(echo "$time" | sed "s/ seconds\\{0,1\\} ago/s/;s/ minutes\\{0,1\\} ago/m/;s/ hours\\{0,1\\} ago/h/;s/ days\\{0,1\\} ago/d/;s/ weeks\\{0,1\\} ago/w/;s/ months\\{0,1\\} ago/mo/;s/ years\\{0,1\\} ago/y/")
  timepart="($time)"
  suffix=""
  suffixwidth=0
  if [ "$hash" = "$remote_hash" ]; then
    suffix="$ICON_CLOUD"
    suffixwidth=1
  fi
  if [ "$hash" = "$head_hash" ]; then
    suffix="${suffix}${ICON_HEAD}"
    suffixwidth=$((suffixwidth + 1))
  fi
  avail=$((cols - ${#timepart} - suffixwidth - 1))
  if [ ${#msg} -gt $avail ]; then
    msg="${msg:0:$avail}"
  fi
  printf "\033[2m%s%s%s\033[0m\n" "$msg" "$timepart" "$suffix"
done
